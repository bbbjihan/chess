# Example Caddyfile snippets for chess.jihan.kr
#
# Production is served from:
#   /opt/vibecoding/chess/prod/current
#
# Preview builds are written by GitHub Actions to:
#   /opt/vibecoding/chess/previews/pr-<number>
#
# Preview Caddy snippets are generated by GitHub Actions under:
#   /opt/vibecoding/chess/caddy/previews/pr-<number>.caddy
#
# This avoids wildcard certificates. Each PR preview gets an explicit
# hostname such as pr-23.chess.jihan.kr, so Caddy can issue a normal
# ACME certificate with HTTP/TLS-ALPN challenge.

{
	email parkjihan.dev@gmail.com
}

chess.jihan.kr {
	root * /opt/vibecoding/chess/prod/current
	encode gzip zstd
	try_files {path} /index.html
	file_server
}

import /opt/vibecoding/chess/caddy/previews/*.caddy
